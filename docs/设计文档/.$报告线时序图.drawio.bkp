        <mxCell id="msg52" value="submitApproval(id, userName)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;" edge="1" parent="1" source="actor_api" target="actor_svc">
