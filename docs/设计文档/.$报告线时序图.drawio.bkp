        <!-- 自动关闭未提交PM -->
        <mxCell id="msg53" value="① UPDATE pm_status SET status='closed'&lt;br&gt;    WHERE status='open' (未提交PM自动关闭)&lt;br&gt;② shouldSkipNode() 检查兼任&lt;br&gt;③ UPDATE report_lines status='reviewing_director'&lt;br&gt;④ INSERT approvals (action='submit')" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontColor=#996600;" edge="1" parent="1" source="actor_svc" target="actor_db">
